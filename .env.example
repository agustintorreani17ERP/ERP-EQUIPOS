# Base de datos de Taller (Postgres / Neon). La app debe conectarse con un rol que
# NO sea dueño de las tablas, para que RLS aplique. Las migraciones corren como dueño.
DATABASE_URL="postgres://USUARIO:CLAVE@HOST/taller?sslmode=require"

# Autenticación con Clerk (la organización de Clerk = la empresa).
CLERK_SECRET_KEY="sk_test_..."
# CLERK_JWT_KEY="..."   # opcional: verificación offline de tokens

# Solo desarrollo: identifica empresa y usuario con cabeceras X-Dev-User / X-Dev-Company.
# Rechazado por el servidor si NODE_ENV=production.
AUTH_BYPASS="false"

# Puerto de la API (el cliente web usa 3100 y hace proxy de /api hacia este puerto).
PORT=3101
